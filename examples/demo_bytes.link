; demo_bytes.link -- integer dialect for the direct binary backend (linkbin)
; AST -> x86-64 machine-code byte sequence -> ELF, no Rust / no linker.
(program
  (let s 0)
  (for i 1 101
    (set s (+ s i)))
  (print "sum 1..100 = " s)                 ; 5050

  (let f 1)
  (for i 1 11
    (set f (* f i)))
  (print "10! = " f)                        ; 3628800

  (let a 0)
  (let b 1)
  (for i 20
    (let t (+ a b))
    (set a b)
    (set b t))
  (print "fib(20) = " a)                    ; 6765

  (print "100/7 = " (/ 100 7))              ; 14
  (print "100 mod 7 = " (mod 100 7))        ; 2
  (print "zero = " 0)
  (print "negative = " (- 0 12345))         ; -12345

  (let k 0)
  (while (< k 3)
    (set k (+ k 1)))
  (print "while k = " k)                    ; 3

  (if (== (mod 15 15) 0)
    (print "15 is divisible by 15\n")
    (print "unreachable\n")))
