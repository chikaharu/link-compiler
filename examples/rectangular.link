// Input rows and output columns. A @ B applies B before A.
fn main() -> Link<C[3], C[2]> {
    let $B: Link<C[3], C[4]> = matrix::<C[3], C[4]>([
        [1, 2, 0, 0],
        [0, 1, 0, 0],
        [1, 0, 1, 0]
    ]);
    let $A: Link<C[4], C[2]> = matrix::<C[4], C[2]>([
        [1, 0], [0, 1], [1, 1], [0, 0]
    ]);
    return $A @ $B;
}
