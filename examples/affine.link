; affine.link -- watch affine chains collapse into single 1x1 Links
(program
  (let x 3.0)
  (let w 2.0)
  ; ((((x*2)+3)*4)-5) is one affine chain: it must become a single aff link, 8x+7
  (let y (- (* (+ (* x 2.0) 3.0) 4.0) 5.0))
  (print "y =" y)                            ; 8*3+7 = 31
  ; crosstalk: w arrives sideways into two mul links; no affine collapse across it
  (let z (+ (* x w) (* y w)))
  (print "z =" z)                            ; 2*(3+31) = 68
  ; an atom (sqrt) breaks the chain; the segment after it collapses again
  (print "sqrt chain =" (+ (* (sqrt 16.0) 3.0) 1.0))   ; 4*3+1 = 13
  ; a loop whose body is one affine step, applied 10 times: x -> x+1 each round
  (let acc 0.0)
  (for i 10.0
    (set acc (+ (* acc 1.0) 1.0)))
  (print "acc =" acc))                       ; 10
