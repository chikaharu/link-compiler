; bench.link -- scalar loop + vector pipeline, the kind of thing
; that is painfully slow as a pure-Python loop.
(program
  (let total 0.0)
  (for i 10000000.0
    (set total (+ total (sqrt (+ i 1.0)))))
  (print "sum_sqrt =" total)

  (let v (iota 1000000.0))
  (let w (cumsum v))
  (print "cumsum_last =" (idx w 999999.0))
  (print "roundtrip_err =" (norm (- (diff w) v))))
